root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.{cshtml,html,css,js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C# style — enforced in build (EnforceCodeStyleInBuild) and by `dotnet format`
# ---------------------------------------------------------------------------
[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:error

# `var`
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Modern language features
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_prefer_top_level_statements = true:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# `using` directives (unused usings are caught by `dotnet format --verify-no-changes` in CI;
# IDE0005-as-build-error needs GenerateDocumentationFile, which a web app has no use for)
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# CA1848 (use LoggerMessage delegates) and CA1873 (guard argument evaluation behind IsEnabled)
# are hot-path logging micro-optimisations. This app logs at startup and on admin actions, so
# the ceremony buys nothing. Structured logging is still expected.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# ---------------------------------------------------------------------------
# EF Core migrations are generated code — don't hold them to the hand-written style.
# ---------------------------------------------------------------------------
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0058.severity = none

# ---------------------------------------------------------------------------
# Test project — behaviour-describing method names use underscores by design
# (Method_Scenario_ExpectedResult), per the project testing standard.
# ---------------------------------------------------------------------------
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none  # constant arrays as arguments — fine in tests
dotnet_diagnostic.CA1711.severity = none  # xUnit [CollectionDefinition] classes end in "Collection"

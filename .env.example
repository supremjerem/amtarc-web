# Copy to `.env` for local development, or set these as environment variables.
# ASP.NET Core maps `Section__Key` to configuration `Section:Key`.

# Database
ConnectionStrings__Amtarc=Host=localhost;Port=5434;Database=amtarc;Username=amtarc;Password=amtarc

# Admin back-office account. The hash is (re-)applied on every startup, so changing
# the password here and restarting is how you rotate it. Password: min 12 chars,
# not a placeholder ("change-me", "password", ...) — the app refuses to boot otherwise.
Admin__Email=admin@amtarc.fr
Admin__Password=

# Uploads. Directory is content-root-relative unless absolute, and deliberately outside wwwroot;
# in production point it at a mounted volume so images survive a redeploy.
# Leave PublicBaseUrl empty for site-relative URLs (/uploads/…), which is what a single-origin
# deployment wants; set it only if images have to be addressed from another origin.
Upload__Directory=App_Data/uploads
Upload__MaxBytes=5242880
Upload__PublicBaseUrl=

# Sign-in throttle, per client IP.
Security__LoginAttemptLimit=10
Security__LoginWindowSeconds=300

# Reverse-proxy hop count for the real client IP (0 for local dev; 1 behind Traefik).
Security__TrustProxyHops=0

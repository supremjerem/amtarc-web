# Copy to `.env` for local development, or set these as environment variables.
# ASP.NET Core maps `Section__Key` to configuration `Section:Key`.

# Database
ConnectionStrings__Amtarc=Host=localhost;Port=5432;Database=amtarc;Username=amtarc;Password=amtarc

# Admin back-office account. The hash is (re-)applied on every startup, so changing
# the password here and restarting is how you rotate it. Password: min 12 chars,
# not a placeholder ("change-me", "password", ...) — the app refuses to boot otherwise.
Admin__Email=admin@amtarc.fr
Admin__Password=

# Uploads
Upload__PublicBaseUrl=http://localhost:5080

# Reverse-proxy hop count for the real client IP (0 for local dev; 1 behind Traefik).
Security__TrustProxyHops=0

# Production settings for docker-compose.prod.yml.
#
# Copy to `.env` on the server — NOT `.env.prod`. `docker compose` only auto-loads `.env`, and a
# stack started without it boots with a blank environment and crash-loops.
#
#   cp .env.prod.example .env
#
# Never commit the filled-in file.

# The public hostname Traefik routes. Use the staging name first (amtarc-next.supremjerem.com),
# then switch to the live one at cutover.
DOMAIN=amtarc.supremjerem.com

# Which GHCR build to run. `latest` follows main; pin a commit SHA to freeze a deploy.
IMAGE_TAG=latest

# Generate fresh values — do not reuse the old stack's:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The back-office account. The app REFUSES TO START if the email is not an address, or the
# password is under 12 characters or a placeholder ("change-me", "password", ...).
# The hash is re-applied on every start, so changing this and restarting is how you rotate it.
ADMIN_EMAIL=bureau@amtarc.fr
ADMIN_PASSWORD=

# How long the public page may be served from the output cache. Admin edits evict it immediately,
# so this is only the safety net. 0 disables caching.
PUBLIC_CACHE_SECONDS=300

@using Amtarc.Web.Content
@model (SocialPlatform Platform, string Color, string HoleColor, int Size)
@switch (Model.Platform)
{
    case SocialPlatform.Facebook:
        <svg viewBox="0 0 24 24" width="@Model.Size" height="@Model.Size" fill="@Model.Color" aria-hidden="true">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.24 10.44 22v-7.02H7.9v-2.92h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.48h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.92h-2.34V22C18.34 21.24 22 17.08 22 12.06Z" />
        </svg>
        break;
    case SocialPlatform.Instagram:
        <svg viewBox="0 0 24 24" width="@Model.Size" height="@Model.Size" fill="none" stroke="@Model.Color" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1.2" fill="@Model.Color" stroke="none" />
        </svg>
        break;
    case SocialPlatform.TikTok:
        <svg viewBox="0 0 24 24" width="@Model.Size" height="@Model.Size" fill="@Model.Color" aria-hidden="true">
            <path d="M16.5 2h-2.9v13.1a2.6 2.6 0 1 1-2.6-2.6c.28 0 .55.04.8.12V9.6a5.7 5.7 0 1 0 4.7 5.6V8.62a6.6 6.6 0 0 0 3.9 1.27V6.94a3.7 3.7 0 0 1-3.9-3.6V2Z" />
        </svg>
        break;
    case SocialPlatform.YouTube:
        <svg viewBox="0 0 24 24" width="@Model.Size" height="@Model.Size" aria-hidden="true">
            <path fill="@Model.Color" d="M23 12s0-3.4-.43-5.03a2.62 2.62 0 0 0-1.84-1.85C19.1 4.7 12 4.7 12 4.7s-7.1 0-8.73.42a2.62 2.62 0 0 0-1.84 1.85C1 8.6 1 12 1 12s0 3.4.43 5.03c.24.9.94 1.6 1.84 1.85 1.63.42 8.73.42 8.73.42s7.1 0 8.73-.42a2.62 2.62 0 0 0 1.84-1.85C23 15.4 23 12 23 12Z" />
            <path fill="@Model.HoleColor" d="M9.75 15.27V8.73L15.5 12l-5.75 3.27Z" />
        </svg>
        break;
}

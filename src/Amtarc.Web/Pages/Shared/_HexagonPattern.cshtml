@model Amtarc.Web.ViewModels.HexagonPatternModel
@{
    var patternId = Amtarc.Web.Infrastructure.HexId.Next("hexagon-pattern");
}
<svg class="@Model.CssClass @Model.OpacityClass" aria-hidden="true">
    <defs>
        <pattern id="@patternId" width="56" height="100" patternUnits="userSpaceOnUse">
            <path d="M28 66L0 50L0 16L28 0L56 16L56 50L28 66L28 100" fill="none" stroke="@Model.Color" stroke-width="2" />
            <path d="M28 0L28 34L0 50L0 84L28 100L56 84L56 50L28 34" fill="none" stroke="@Model.Color" stroke-width="2" />
        </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#@patternId)" />
</svg>

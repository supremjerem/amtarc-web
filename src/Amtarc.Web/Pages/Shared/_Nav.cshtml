@using Amtarc.Web.Content
<nav class="site-nav fixed inset-x-0 top-0 z-[100] backdrop-blur-[18px] backdrop-saturate-[1.8]">
    <div class="mx-auto flex h-[60px] w-full max-w-[1240px] items-center justify-between px-[28px]">
        <a href="/" class="flex items-center gap-3">
            <img src="~/img/panther.png" alt="Panthère AMTARC" width="698" height="760"
                 fetchpriority="high"
                 class="h-[34px] w-auto drop-shadow-[0_1px_2px_rgba(0,0,0,0.25)]" />
            <span class="display-wordmark bg-gold-gradient bg-clip-text text-2xl leading-none text-transparent">
                AMTARC
            </span>
        </a>

        <div class="hidden items-center gap-8 lg:flex">
            @foreach (var link in SiteContentDefaults.NavLinks)
            {
                <a href="@link.Href" class="text-[13.5px] font-semibold text-ink-secondary transition-colors hover:text-ink">@link.Label</a>
            }
            <partial name="_PillButton" model='new PillButtonModel { Href = "#contact", Label = "Nous rejoindre", Variant = PillButtonVariant.Gold }' />
        </div>

        <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu"
                aria-label="Ouvrir le menu"
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-ink/10 lg:hidden">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <div id="mobile-menu" data-menu-panel class="hidden border-t border-ink/10 bg-white/95 px-[28px] py-4 lg:hidden">
        <div class="flex flex-col gap-3">
            @foreach (var link in SiteContentDefaults.NavLinks)
            {
                <a href="@link.Href" class="text-sm font-semibold text-ink-secondary">@link.Label</a>
            }
            <a href="#contact" class="mt-1 inline-flex w-fit items-center rounded-pill bg-gold-gradient px-5 py-2.5 text-sm font-extrabold text-ink">Nous rejoindre</a>
        </div>
    </div>
</nav>

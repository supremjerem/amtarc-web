@model Amtarc.Web.ViewModels.NewsFormInput
@using Amtarc.Web.Domain
@{
    const string FieldClass = "w-full rounded-lg border border-ink/15 bg-cream-50 px-3 py-2 text-sm text-ink outline-none focus:border-gold focus:ring-2 focus:ring-gold/40";
    const string LabelClass = "mb-1.5 block text-sm font-semibold text-ink-secondary";
    const string ErrorClass = "mt-1 block text-xs text-orange-700";
}

<label class="block">
    <span class="@LabelClass">Titre</span>
    <input asp-for="Title" required class="@FieldClass" />
    <span asp-validation-for="Title" class="@ErrorClass"></span>
</label>

<label class="block">
    <span class="@LabelClass">Catégorie</span>
    <select asp-for="Category" asp-items="Html.GetEnumSelectList<NewsCategory>()" class="@FieldClass"></select>
    <span asp-validation-for="Category" class="@ErrorClass"></span>
</label>

<label class="block">
    <span class="@LabelClass">Résumé</span>
    <input asp-for="Excerpt" class="@FieldClass" />
    <span asp-validation-for="Excerpt" class="@ErrorClass"></span>
</label>

<label class="block">
    <span class="@LabelClass">Texte</span>
    <textarea asp-for="Body" rows="8" required class="@FieldClass"></textarea>
    <span asp-validation-for="Body" class="@ErrorClass"></span>
</label>

<fieldset class="flex flex-col gap-2">
    <legend class="@LabelClass">Image (optionnel)</legend>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="flex items-center gap-3">
            <img src="@Model.ImageUrl" alt="Aperçu de l'image"
                 class="h-16 w-24 rounded-lg border border-ink/10 object-cover" />
            <span class="min-w-0 break-all font-data text-xs text-ink-soft">@Model.ImageUrl</span>
        </div>
    }

    <label class="block">
        <span class="@LabelClass">Téléverser une image</span>
        <input type="file" name="Image" accept="image/jpeg,image/png,image/webp,image/gif"
               class="@FieldClass file:mr-3 file:rounded-full file:border-0 file:bg-gold-gradient file:px-4 file:py-1.5 file:text-xs file:font-extrabold" />
    </label>

    <label class="block">
        <span class="@LabelClass">ou adresse de l'image</span>
        <input asp-for="ImageUrl" class="@FieldClass" />
        <span asp-validation-for="ImageUrl" class="@ErrorClass"></span>
    </label>
</fieldset>

<label class="flex items-center gap-2">
    <input asp-for="Published" type="checkbox" class="size-4 accent-gold-dark" />
    <span class="text-sm font-semibold text-ink-secondary">Publié</span>
</label>

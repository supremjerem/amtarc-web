@using Amtarc.Web.Content
@{ var footer = SiteContentDefaults.Footer; }
<footer class="relative overflow-hidden bg-brand">
    <partial name="_HexagonPattern" model='new HexagonPatternModel { Color = "#ffb200", OpacityClass = "opacity-[0.06]" }' />
    <div class="relative mx-auto w-full max-w-[1240px] px-[28px] pt-14 pb-10">
        <div class="mb-11 grid grid-cols-1 gap-9 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
            <div>
                <a href="#top" class="mb-4 flex items-center gap-3">
                    <img src="~/img/panther.png" alt="Panthère AMTARC" width="698" height="760" loading="lazy" class="h-[38px] w-auto" />
                    <span class="bg-gold-gradient bg-clip-text display-wordmark text-[26px] leading-none text-transparent">AMTARC</span>
                </a>
                <p class="mb-6 max-w-[280px] text-sm leading-relaxed text-on-dark">@footer.Tagline</p>
                <partial name="_SocialLinks" model="SocialLinksVariant.Footer" />
            </div>

            @foreach (var column in footer.Columns)
            {
                <div>
                    <div class="mb-4 text-xs font-extrabold tracking-[0.1em] text-white">@column.Title</div>
                    <div class="flex flex-col gap-[11px]">
                        @foreach (var link in column.Links)
                        {
                            <a href="@link.Href"
                               @(link.External ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)
                               class="text-sm text-on-dark transition-colors hover:text-gold">@link.Label</a>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/[0.12] pt-6">
            <div class="text-[12.5px] text-on-dark-muted">&copy; @DateTime.UtcNow.Year AMTARC · Tous droits réservés</div>
            <div class="text-[12.5px] text-on-dark-muted">@footer.Location</div>
        </div>
    </div>
</footer>

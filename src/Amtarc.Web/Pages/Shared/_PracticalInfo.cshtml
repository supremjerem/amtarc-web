@using Amtarc.Web.Content
@model PracticalInfoContent
<section id="infos" class="scroll-mt-[76px] pt-5 pb-24">
    <div class="mx-auto grid w-full max-w-[1240px] grid-cols-1 gap-4 px-[28px] md:grid-cols-2">
        <div class="reveal relative overflow-hidden rounded-[26px] bg-brand p-10">
            <partial name="_HexagonPattern" model='new HexagonPatternModel { Color = "#ffb200", OpacityClass = "opacity-[0.1]" }' />
            <div class="relative">
                <div class="mb-[18px] data-label text-gold">@Model.HoursKicker</div>
                <div class="flex flex-col">
                    @for (var i = 0; i < Model.Hours.Count; i++)
                    {
                        <div class="flex items-center justify-between py-4 @(i < Model.Hours.Count - 1 ? "border-b border-white/[0.12]" : "")">
                            <span class="display text-[19px] text-white">@Model.Hours[i].Day</span>
                            <span class="data-figure text-[15px] text-on-dark-lighter">@Model.Hours[i].Time</span>
                        </div>
                    }
                </div>
                <p class="mt-5 text-sm leading-[1.5] text-on-dark">@Model.HoursNote</p>
            </div>
        </div>

        <div class="reveal rounded-[26px] border border-ink/10 bg-white p-10 shadow-card">
            <div class="mb-[18px] data-label text-overline">@Model.MembershipKicker</div>
            <h3 class="mb-[18px] display text-[22px]">@Model.MembershipHeading</h3>
            <div class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
                @foreach (var item in Model.MembershipChecklist)
                {
                    <div class="flex items-baseline gap-2.5 text-[14.5px] font-semibold text-ink-secondary">
                        <span class="text-orange" aria-hidden="true">&rsaquo;</span> @item
                    </div>
                }
            </div>
            <p class="mt-[22px] text-sm leading-[1.55] text-ink-soft">@Model.MembershipNote</p>
            <a href="@Model.MembershipCta.Href" class="mt-5 inline-block text-[14.5px] font-extrabold text-overline transition-colors hover:text-orange">@Model.MembershipCta.Label</a>
        </div>
    </div>
</section>

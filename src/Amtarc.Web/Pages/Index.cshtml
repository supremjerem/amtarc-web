@page
@model IndexModel
@{
    ViewData["Title"] = null;
}

@*
    Phase 3a — design-system proof.

    This page is scaffolding: it exercises every piece of the ported design system so the
    build, the fonts and site.ts can be verified end to end. Phase 3b replaces it with the
    eight real homepage sections.
*@

<nav class="site-nav fixed inset-x-0 top-0 z-[100] backdrop-blur-[18px] backdrop-saturate-[1.8]">
    <div class="mx-auto flex h-[60px] w-full max-w-[1240px] items-center justify-between px-[28px]">
        <a href="/" class="flex items-center gap-3">
            <img src="~/img/panther.png" alt="Panthère AMTARC" width="698" height="760"
                 class="h-[34px] w-auto drop-shadow-[0_1px_2px_rgba(0,0,0,0.25)]" fetchpriority="high" />
            <span class="display-wordmark bg-gold-gradient bg-clip-text text-2xl leading-none text-transparent">
                AMTARC
            </span>
        </a>

        <div class="hidden items-center gap-8 lg:flex">
            <a href="#club" class="text-[13.5px] font-semibold text-ink-secondary transition-colors hover:text-ink">Le club</a>
            <a href="#type" class="text-[13.5px] font-semibold text-ink-secondary transition-colors hover:text-ink">Typographie</a>
            <a href="#motion" class="text-[13.5px] font-semibold text-ink-secondary transition-colors hover:text-ink">Animations</a>
            <a href="#contact" class="rounded-pill bg-gold-gradient px-[18px] py-2 text-[13px] font-bold text-ink shadow-btn-gold">
                Nous rejoindre
            </a>
        </div>

        <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu"
                aria-label="Ouvrir le menu"
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-ink/10 lg:hidden">
            <span class="sr-only">Menu</span>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <div id="mobile-menu" data-menu-panel class="hidden border-t border-ink/10 bg-white/95 px-[28px] py-4 lg:hidden">
        <div class="flex flex-col gap-3">
            <a href="#club" class="text-sm font-semibold text-ink-secondary">Le club</a>
            <a href="#type" class="text-sm font-semibold text-ink-secondary">Typographie</a>
            <a href="#motion" class="text-sm font-semibold text-ink-secondary">Animations</a>
        </div>
    </div>
</nav>

<main class="pt-[60px]">
    <header class="relative flex min-h-screen items-center overflow-hidden py-24">
        <div class="pointer-events-none absolute -right-[120px] -bottom-[160px] h-[640px] w-[640px] rounded-full bg-[radial-gradient(circle,rgba(255,175,0,0.35),rgba(255,175,0,0)_66%)]"></div>

        <div class="relative z-[2] mx-auto grid w-full max-w-[1240px] grid-cols-1 items-center gap-8 px-[28px] md:grid-cols-[1.15fr_0.85fr]">
            <div>
                <div class="animate-reveal data-label mb-6 inline-flex items-center gap-[9px] rounded-pill border border-ink/[0.14] bg-white/70 px-[15px] py-[7px] text-ink-soft">
                    <span class="h-[7px] w-[7px] rounded-[2px] bg-gold-gradient"></span>
                    CLUB DE TIR · MEAUZAC · TARN-ET-GARONNE
                </div>

                <div class="animate-reveal display-wordmark mb-[18px] bg-hero-gradient bg-clip-text text-[clamp(60px,11vw,142px)] leading-[0.84] text-transparent">
                    AMTARC
                </div>

                <h1 class="animate-reveal display mb-5 text-[clamp(26px,3.4vw,42px)] leading-[1.05]">
                    La précision<br />ne s'improvise pas.
                </h1>

                <p class="animate-reveal mb-[34px] max-w-[500px] text-[clamp(16px,1.7vw,19px)] leading-[1.55] font-medium text-ink-body">
                    Cette page vérifie le portage du système de design : les trois rôles typographiques,
                    les jetons de couleur, et les cinq effets repris de l'ancien site.
                </p>

                <div class="animate-reveal flex flex-wrap gap-3.5">
                    <a href="#type" class="rounded-pill bg-gold-gradient px-[30px] py-3.5 text-[15px] font-bold text-ink shadow-btn-gold-lg">
                        Voir la typographie
                    </a>
                    <a href="#motion" class="rounded-pill bg-brand px-[30px] py-3.5 text-[15px] font-bold text-white">
                        Voir les animations
                    </a>
                </div>
            </div>

            <div class="relative flex items-center justify-center">
                <img src="~/img/amtarc-logo.png" alt="AMTARC — panthère, pistolet, croix occitane et écusson IPSC"
                     width="1400" height="793"
                     class="relative h-auto w-full max-w-[560px] drop-shadow-[0_24px_42px_rgba(20,16,8,0.32)]" />
            </div>
        </div>
    </header>

    <section id="type" class="mx-auto max-w-[1240px] scroll-mt-[96px] px-[28px] py-24">
        <div class="reveal">
            <div class="data-label mb-2 text-overline">— LES TROIS RÔLES</div>
            <h2 class="display display-animated display-compressed mb-10 text-[clamp(34px,4.6vw,58px)] leading-none">
                Un titre qui s'élargit.
            </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3" data-stagger="90">
            <div class="reveal rounded-card border border-ink/10 bg-white p-7 shadow-card">
                <div class="data-label mb-3 text-overline">DISPLAY · ARCHIVO</div>
                <p class="display mb-2 text-2xl">Titres et intertitres</p>
                <p class="text-sm text-ink-body">Axe de largeur variable — c'est lui qui porte l'animation signature.</p>
            </div>
            <div class="reveal rounded-card border border-ink/10 bg-white p-7 shadow-card">
                <div class="data-label mb-3 text-overline">BODY · INSTRUMENT SANS</div>
                <p class="mb-2 text-lg font-medium">Paragraphes et libellés</p>
                <p class="text-sm text-ink-body">Hérité du body, c'est la police par défaut de toute la page.</p>
            </div>
            <div class="reveal rounded-card border border-ink/10 bg-white p-7 shadow-card">
                <div class="data-label mb-3 text-overline">DATA · MARTIAN MONO</div>
                <p class="data-figure mb-2 text-2xl">200 m · 14 h 00</p>
                <p class="text-sm text-ink-body">Valeurs mesurées : dates, horaires, distances, montants.</p>
            </div>
        </div>
    </section>

    <section id="motion" class="bg-tsv-gradient scroll-mt-[96px] py-24">
        <div class="mx-auto max-w-[1240px] px-[28px]">
            <div class="reveal">
                <div class="data-label mb-2 text-overline">— EFFETS PORTÉS</div>
                <h2 class="display display-animated display-compressed mb-10 text-[clamp(34px,4.6vw,58px)] leading-none">
                    Cinq effets, zéro framework.
                </h2>
            </div>

            <div class="mb-12 flex flex-wrap gap-10" data-stagger="120">
                <div class="reveal">
                    <div class="data-figure text-[42px] text-ink" data-count-to="5">0</div>
                    <div class="text-[12.5px] font-bold text-[#8a744a]">disciplines de tir</div>
                </div>
                <div class="reveal">
                    <div class="data-figure text-[42px] text-ink" data-count-to="10">0</div>
                    <div class="text-[12.5px] font-bold text-[#8a744a]">alvéoles TSV</div>
                </div>
                <div class="reveal">
                    <div class="data-figure text-[42px] text-ink" data-count-to="200">0</div>
                    <div class="text-[12.5px] font-bold text-[#8a744a]">mètres — distance max</div>
                </div>
            </div>

            <ul class="grid grid-cols-1 gap-4 md:grid-cols-2" data-stagger="70">
                <li class="reveal rounded-card bg-white/70 p-5 text-sm text-ink-body">Morph de largeur des titres au scroll</li>
                <li class="reveal rounded-card bg-white/70 p-5 text-sm text-ink-body">Apparition en fondu des blocs</li>
                <li class="reveal rounded-card bg-white/70 p-5 text-sm text-ink-body">Décalage progressif dans les grilles</li>
                <li class="reveal rounded-card bg-white/70 p-5 text-sm text-ink-body">Compteurs animés</li>
                <li class="reveal rounded-card bg-white/70 p-5 text-sm text-ink-body">Barre de nav qui se solidifie</li>
                <li class="reveal rounded-card bg-white/70 p-5 text-sm text-ink-body">Menu mobile</li>
            </ul>
        </div>
    </section>

    <footer id="contact" class="bg-brand py-16">
        <div class="mx-auto max-w-[1240px] px-[28px]">
            <div class="mb-4 flex items-center gap-3">
                <img src="~/img/panther.png" alt="" width="698" height="760" class="h-[38px] w-auto" />
                <span class="display-wordmark bg-gold-gradient bg-clip-text text-[26px] leading-none text-transparent">
                    AMTARC
                </span>
            </div>
            <p class="max-w-[280px] text-sm leading-relaxed text-on-dark">
                Phase 3a — fondation du système de design. Les sections réelles arrivent en phase 3b.
            </p>
        </div>
    </footer>
</main>

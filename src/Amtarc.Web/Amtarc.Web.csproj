<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Amtarc.Web</RootNamespace>
    <UserSecretsId>amtarc-web</UserSecretsId>
    <!-- Set to false to skip the Node asset build (CI builds the assets in its own step). -->
    <BuildFrontendAssets Condition="'$(BuildFrontendAssets)' == ''">true</BuildFrontendAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- Node is a build-time tool only: it compiles Tailwind and bundles site.ts. The published
       image never contains Node or node_modules — see the Dockerfile's separate asset stage. -->
  <ItemGroup>
    <FrontendSource Include="Styles/**/*.css;Scripts/**/*.ts;Pages/**/*.cshtml;package.json" />
    <FrontendOutput Include="wwwroot/css/site.css;wwwroot/js/site.js" />
  </ItemGroup>

  <Target Name="InstallFrontendDependencies"
          Condition="'$(BuildFrontendAssets)' == 'true' AND !Exists('node_modules')">
    <Message Importance="high" Text="Installing front-end build dependencies (npm ci)…" />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildFrontendAssets"
          Condition="'$(BuildFrontendAssets)' == 'true'"
          DependsOnTargets="InstallFrontendDependencies"
          BeforeTargets="BeforeBuild"
          Inputs="@(FrontendSource)"
          Outputs="@(FrontendOutput)">
    <Message Importance="high" Text="Building front-end assets (Tailwind + esbuild)…" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- The Node toolchain is build-time only: none of it belongs in the published output or the
       runtime image, and node_modules has to stay out of the content glob entirely. -->
  <ItemGroup>
    <Content Remove="node_modules/**" />
    <None Remove="node_modules/**" />
    <Content Update="package.json;package-lock.json;tsconfig.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
